# MARUTI Desktop Assistant Configuration Example
# Copy this file to .env and adjust values as needed.

# =====================================================================
# Cloud & AI Features (Optional)
# If left empty, MARUTI runs fully offline with its rule-based router.
# Get a key from: https://aistudio.google.com/
# =====================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# =====================================================================
# Localization & Audio Input Defaults
# =====================================================================
MARUTI_CITY=Boisar
MARUTI_STT_LANG=en-IN
MARUTI_STT_SECONDARY_LANG=hi-IN
MARUTI_STT_ENERGY_THRESHOLD=300
MARUTI_STT_DYNAMIC_ENERGY=true
MARUTI_STT_PAUSE_THRESHOLD=0.8
MARUTI_STT_NON_SPEAKING_DURATION=0.5
MARUTI_STT_TIMEOUT=5.0
MARUTI_STT_PHRASE_LIMIT=10.0
MARUTI_REVIEW_MODE=false

# =====================================================================
# OCR & Computer Vision (pytesseract)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux default: /usr/bin/tesseract (usually auto-detected on PATH)
# =====================================================================
TESSERACT_CMD=

# =====================================================================
# Text-To-Speech (TTS) Settings
# Engine options: auto, spd-say, espeak-ng, pyttsx3
# =====================================================================
MARUTI_TTS_ENGINE=auto
MARUTI_TTS_RATE=175
MARUTI_TTS_VOLUME=1.0

# =====================================================================
# Soft-Computing Decision Thresholds (0.0 to 1.0)
# =====================================================================
MARUTI_ACT_THRESHOLD=0.85
MARUTI_ASK_THRESHOLD=0.60
MARUTI_MAX_STEPS=6

